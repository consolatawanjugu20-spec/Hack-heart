<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday, My Love! 💕</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #a0d8ef;
      font-family: 'Georgia', serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow: hidden;
      position: relative;
    }

    /* Floating hearts and flowers background */
    .floating-container {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: hidden;
    }

    .float-item {
      position: absolute;
      bottom: -100px;
      font-size: 2rem;
      opacity: 0.7;
      animation: floatUp 8s linear infinite;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(0) rotate(0deg);
        opacity: 0.8;
      }
      100% {
        transform: translateY(-120vh) rotate(360deg);
        opacity: 0;
      }
    }

    /* Floating animation staggered delays */
    .float-item:nth-child(1) { left: 10%; animation-duration: 7s; animation-delay: 0s; }
    .float-item:nth-child(2) { left: 25%; animation-duration: 9s; animation-delay: 2s; }
    .float-item:nth-child(3) { left: 40%; animation-duration: 6s; animation-delay: 1s; }
    .float-item:nth-child(4) { left: 55%; animation-duration: 8s; animation-delay: 3s; }
    .float-item:nth-child(5) { left: 70%; animation-duration: 10s; animation-delay: 0.5s; }
    .float-item:nth-child(6) { left: 85%; animation-duration: 7.5s; animation-delay: 2.5s; }

    /* Romantic Glass Card */
    .card {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(8px);
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      max-width: 450px;
      width: 85%;
      padding: 40px 30px;
      text-align: center;
      border: 2px solid rgba(255, 255, 255, 0.5);
      z-index: 10;
    }

    h1 {
      color: #e63946;
      font-size: 2.2rem;
      margin-bottom: 20px;
    }

    p {
      color: #333333;
      font-size: 1.2rem;
      line-height: 1.6;
      margin-bottom: 25px;
    }

    .heart-icon {
      font-size: 2.5rem;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.15); }
      100% { transform: scale(1); }
    }
  </style>
</head>
<body>

  <!-- Floating Elements -->
  <div class="floating-container">
    <div class="float-item">💖</div>
    <div class="float-item">🌸</div>
    <div class="float-item">💕</div>
    <div class="float-item">🌹</div>
    <div class="float-item">💗</div>
    <div class="float-item">🌺</div>
  </div>

  <!-- Main Card -->
  <div class="card">
    <div class="heart-icon">💖</div>
    <h1>Happy Birthday, My Love</h1>
    <p>
      You are my constant joy and the sweetness in my life. 
      Every moment with you is a cherished gift. 
      I love you endlessly.
    </p>
    <div style="font-size: 1.5rem;">🌸✨🌹</div>
  </div>

</body>
</html>
